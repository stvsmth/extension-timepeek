{
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_icon": "icons/timepeek-48.png",
    "default_popup": "popup/timepeek.html",
    "default_title": "Timepeek"
  }
}

